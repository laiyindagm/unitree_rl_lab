from __future__ import annotations

from dataclasses import MISSING, field

from isaaclab.envs.mdp import UniformVelocityCommandCfg, UniformVelocityCommand
from isaaclab.utils import configclass

import torch
from collections.abc import Sequence
from typing import Any


@configclass
class UniformLevelVelocityCommandCfg(UniformVelocityCommandCfg):
    limit_ranges: UniformVelocityCommandCfg.Ranges = MISSING
    rel_rotating_envs: float = 0.0
    """Probability of environments that should be pure-rotation (lin_vel=0, ang_vel sampled). Defaults to 0.0."""


class UniformLevelVelocityCommand(UniformVelocityCommand):
    """Extends the base velocity command with rotating-only environments."""

    cfg: UniformLevelVelocityCommandCfg

    def __init__(self, cfg: UniformLevelVelocityCommandCfg, env):
        super().__init__(cfg, env)
        self.is_rotating_env = torch.zeros(self.num_envs, dtype=torch.bool, device=self.device)

    def _resample_command(self, env_ids: Sequence[int]):
        super()._resample_command(env_ids)
        # update rotating envs
        r = torch.empty(len(env_ids), device=self.device)
        self.is_rotating_env[env_ids] = r.uniform_(0.0, 1.0) <= self.cfg.rel_rotating_envs

    def _update_command(self):
        super()._update_command()
        # Enforce pure rotation (zero lin vel) for rotating envs
        rotating_env_ids = self.is_rotating_env.nonzero(as_tuple=False).flatten()
        self.vel_command_b[rotating_env_ids, :2] = 0.0


# Patch the cfg to use our custom command class
_ulvc_orig_post_init = UniformLevelVelocityCommandCfg.__post_init__
def _ulvc_post_init(self):
    _ulvc_orig_post_init(self)
    self.class_type = UniformLevelVelocityCommand
UniformLevelVelocityCommandCfg.__post_init__ = _ulvc_post_init


# ============================================================================
# Performance-Weighted Adaptive Command Sampling (V2 — Explicit Bin Layout)
#
# Key changes from V1:
#   1. EXPLICIT bin edges for vx and wz (non-uniform, asymmetric)
#   2. Dead zone [-0.05, 0.05] excluded from sampling (treated as standing)
#   3. Outermost bins can expand via curriculum (per-bin limit edges)
#   4. Guaranteed pure-rotation and standing proportions
#   5. vx/wz bins sampled INDEPENDENTLY (not grid) — equivalent to marginal
#      sampling but with per-cell performance tracking
# ============================================================================


@configclass
class PerformanceWeightedVelocityCommandCfg(UniformVelocityCommandCfg):
    """Cfg for performance-weighted command with explicit asymmetric bins."""
    limit_ranges: UniformVelocityCommandCfg.Ranges = MISSING
    rel_rotating_envs: float = 0.0
    rel_linear_envs: float = 0.0

    # Explicit bin edges: list of (lo, hi) tuples defining each bin.
    # The LAST positive and first negative bins are expandable via curriculum.
    # Dead zone [-0.05, 0.05] is NOT a bin — it's never sampled.
    vx_bins: list[Any] = field(default_factory=lambda: [
        # backward (sorted negative-to-positive)
        (-0.55, -0.35),  # expandable to limit_ranges.lin_vel_x[0]
        (-0.35, -0.25),
        (-0.25, -0.15),
        (-0.15, -0.05),
        # forward
        (0.05, 0.15),
        (0.15, 0.25),
        (0.25, 0.35),
        (0.35, 0.80),   # expandable to limit_ranges.lin_vel_x[1]
    ])

    wz_bins: list[Any] = field(default_factory=lambda: [
        # negative
        (-0.50, -0.35),  # expandable to limit_ranges.ang_vel_z[0]
        (-0.35, -0.25),
        (-0.25, -0.15),
        (-0.15, -0.05),
        # positive
        (0.05, 0.15),
        (0.15, 0.25),
        (0.25, 0.35),
        (0.35, 0.50),   # expandable to limit_ranges.ang_vel_z[1]
    ])

    # Adaptive sampling parameters
    ema_alpha: float = 0.1
    temperature: float = 2.0
    min_sampling_prob: float = 0.02
    accuracy_cmd_min: float = 0.08
    """Minimum command norm for accuracy computation. Commands below this
    are excluded from bin performance updates (too noisy)."""
    zero_speed_accuracy_threshold: float = 0.05
    """Velocity threshold for zero-speed accuracy. At cmd=0, accuracy is
    clamp(1 - vel/threshold, 0, 1) — perfectly still = 1.0."""

    num_active_vx_bins: int | None = None
    """Number of initially active vx bins (indices 0..N-1). None = all active.
    Bins should be ordered center-outward for staged curriculum expansion."""
    num_active_wz_bins: int | None = None
    """Same for wz bins."""


class PerformanceWeightedVelocityCommand(UniformVelocityCommand):
    """Velocity command with adaptive bin sampling — explicit bin layout.

    Independently samples vx-bin and wz-bin, tracks per-(vx_bin, wz_bin) cell
    accuracy via EMA, samples cells inversely proportional to accuracy.

    Standing envs get vel=0 (via base class). Rotating envs get vx=0, wz from
    wz_bins. Normal envs get independent vx, wz from their respective bins.

    Dead zone [-0.05, 0.05] is NEVER sampled for either axis — those commands
    come only from the standing/rotating env allocation.
    """

    cfg: PerformanceWeightedVelocityCommandCfg

    def __init__(self, cfg: PerformanceWeightedVelocityCommandCfg, env):
        super().__init__(cfg, env)
        self.is_rotating_env = torch.zeros(self.num_envs, dtype=torch.bool, device=self.device)
        self.is_linear_env = torch.zeros(self.num_envs, dtype=torch.bool, device=self.device)

        n_vx = len(cfg.vx_bins)
        n_wz = len(cfg.wz_bins)

        # Convert bin lists to tensors for vectorized ops
        self._vx_edges = torch.tensor(cfg.vx_bins, device=self.device, dtype=torch.float32)  # (n_vx, 2)
        self._wz_edges = torch.tensor(cfg.wz_bins, device=self.device, dtype=torch.float32)  # (n_wz, 2)

        # EMA performance per cell, initialized to 0.5 (neutral)
        self._bin_perf = torch.full((n_vx, n_wz), 0.5, device=self.device)
        # Track which bin each env belongs to
        self._env_vx_bin = torch.zeros(self.num_envs, dtype=torch.long, device=self.device)
        self._env_wz_bin = torch.zeros(self.num_envs, dtype=torch.long, device=self.device)
        # Count updates per bin for logging
        self._bin_update_count = torch.zeros((n_vx, n_wz), dtype=torch.long, device=self.device)

        # Per-env accuracy accumulators (reset at episode end)
        self._env_accuracy_sum = torch.zeros(self.num_envs, device=self.device)
        self._env_accuracy_count = torch.zeros(self.num_envs, dtype=torch.long, device=self.device)

        # Find zero-speed bin indices (for routing standing/rotating envs)
        # A bin is "zero-speed" if both lo and hi are 0 (discrete zero level)
        self._zero_vx_bin = -1
        for i, (lo, hi) in enumerate(cfg.vx_bins):
            if abs(lo) < 1e-6 and abs(hi) < 1e-6:
                self._zero_vx_bin = i
                break
        self._zero_wz_bin = -1
        for i, (lo, hi) in enumerate(cfg.wz_bins):
            if abs(lo) < 1e-6 and abs(hi) < 1e-6:
                self._zero_wz_bin = i
                break

        # Active-bin masking for staged curriculum (discrete levels)
        if cfg.num_active_vx_bins is not None or cfg.num_active_wz_bins is not None:
            self._active_n_vx = n_vx if cfg.num_active_vx_bins is None else min(cfg.num_active_vx_bins, n_vx)
            self._active_n_wz = n_wz if cfg.num_active_wz_bins is None else min(cfg.num_active_wz_bins, n_wz)
            self._update_active_mask()

    def _update_active_mask(self):
        """Update the active bin mask based on current active counts."""
        n_vx = self._vx_edges.shape[0]
        n_wz = self._wz_edges.shape[0]
        mask = torch.zeros((n_vx, n_wz), dtype=torch.bool, device=self.device)
        mask[:self._active_n_vx, :self._active_n_wz] = True
        self._active_mask = mask

    def _compute_sampling_probs(self):
        """Compute per-cell sampling probabilities: worse performance -> higher prob."""
        difficulty = 1.0 - self._bin_perf  # shape (n_vx, n_wz)
        n_wz = self._wz_edges.shape[0]
        flat = difficulty.flatten()
        logits = flat * self.cfg.temperature
        # Mask inactive bins (staged curriculum) — softmax(-inf) = 0
        if hasattr(self, '_active_mask'):
            logits[~self._active_mask.flatten()] = float('-inf')
        # Exclude zero-speed cell from adaptive sampling —
        # standing/rotating env allocation already handles zero-speed practice
        if self._zero_vx_bin >= 0 and self._zero_wz_bin >= 0:
            zero_cell = self._zero_vx_bin * n_wz + self._zero_wz_bin
            logits[zero_cell] = float('-inf')
        probs = torch.softmax(logits, dim=0)
        # Auto-scale floor: must be < 1/N_active to preserve differentiation
        # (fixed min_sampling_prob=0.02 > 1/64=0.0156 killed V17a's adaptive)
        n_active = (probs > 0).sum().item()
        floor = min(self.cfg.min_sampling_prob, 0.5 / max(n_active, 1))
        probs = torch.clamp(probs, min=floor)
        if hasattr(self, '_active_mask'):
            probs[~self._active_mask.flatten()] = 0.0
        if self._zero_vx_bin >= 0 and self._zero_wz_bin >= 0:
            probs[zero_cell] = 0.0
        probs = probs / probs.sum()
        return probs  # flat (n_vx * n_wz,)

    def _resample_command(self, env_ids: Sequence[int]):
        if isinstance(env_ids, torch.Tensor):
            env_ids_t = env_ids
            n = env_ids.shape[0]
        else:
            n = len(env_ids)
            env_ids_t = torch.tensor(env_ids, device=self.device, dtype=torch.long)

        if n == 0:
            return

        r = self.cfg.ranges
        n_wz = len(self.cfg.wz_bins)

        # --- Adaptive cell sampling (fully vectorized) ---
        probs = self._compute_sampling_probs()
        cell_indices = torch.multinomial(probs, n, replacement=True)
        vx_bin = cell_indices // n_wz
        wz_bin = cell_indices % n_wz

        self._env_vx_bin[env_ids_t] = vx_bin
        self._env_wz_bin[env_ids_t] = wz_bin

        # Sample vx uniformly within its bin
        vx_lo = self._vx_edges[vx_bin, 0]
        vx_hi = self._vx_edges[vx_bin, 1]
        vx = vx_lo + torch.rand(n, device=self.device) * (vx_hi - vx_lo)

        # Sample vy uniformly from full range (not binned)
        vy = torch.empty(n, device=self.device).uniform_(r.lin_vel_y[0], r.lin_vel_y[1])

        # Sample wz uniformly within its bin
        wz_lo = self._wz_edges[wz_bin, 0]
        wz_hi = self._wz_edges[wz_bin, 1]
        wz = wz_lo + torch.rand(n, device=self.device) * (wz_hi - wz_lo)

        self.vel_command_b[env_ids_t, 0] = vx
        self.vel_command_b[env_ids_t, 1] = vy
        self.vel_command_b[env_ids_t, 2] = wz

        # --- Standing / Rotating / Heading env assignment ---
        self.is_standing_env[env_ids_t] = torch.rand(n, device=self.device) <= self.cfg.rel_standing_envs
        self.is_rotating_env[env_ids_t] = torch.rand(n, device=self.device) <= self.cfg.rel_rotating_envs
        self.is_linear_env[env_ids_t] = torch.rand(n, device=self.device) <= self.cfg.rel_linear_envs

        # Route standing/rotating/linear envs to zero-speed bins (if they exist)
        standing_local = self.is_standing_env[env_ids_t]
        rotating_local = self.is_rotating_env[env_ids_t]
        linear_local = self.is_linear_env[env_ids_t]
        if hasattr(self, '_zero_vx_bin') and self._zero_vx_bin >= 0:
            # Standing and rotating envs: vx=0, so route to zero-vx bin
            self._env_vx_bin[env_ids_t[standing_local | rotating_local]] = self._zero_vx_bin
        if hasattr(self, '_zero_wz_bin') and self._zero_wz_bin >= 0:
            # Standing and linear envs: wz=0, route to zero-wz bin
            self._env_wz_bin[env_ids_t[standing_local | linear_local]] = self._zero_wz_bin

        if self.cfg.heading_command:
            self.heading_target[env_ids_t] = torch.empty(n, device=self.device).uniform_(*self.cfg.ranges.heading)
            self.is_heading_env[env_ids_t] = torch.rand(n, device=self.device) <= self.cfg.rel_heading_envs

    def _update_command(self):
        super()._update_command()  # zeros standing envs, computes heading
        # Enforce pure rotation for rotating envs
        rotating_ids = self.is_rotating_env.nonzero(as_tuple=False).flatten()
        self.vel_command_b[rotating_ids, :2] = 0.0
        # Enforce pure linear for linear envs
        linear_ids = self.is_linear_env.nonzero(as_tuple=False).flatten()
        self.vel_command_b[linear_ids, 2] = 0.0

        # --- Accumulate relative tracking accuracy per env ---
        cmd_lin = self.vel_command_b[:, :2]
        cmd_ang = self.vel_command_b[:, 2]

        actual_lin = self.robot.data.root_lin_vel_b[:, :2]
        actual_ang = self.robot.data.root_ang_vel_b[:, 2]

        cmd_min = self.cfg.accuracy_cmd_min

        # Linear velocity accuracy
        cmd_lin_norm = torch.norm(cmd_lin, dim=1)
        lin_error = torch.norm(cmd_lin - actual_lin, dim=1)
        has_lin = cmd_lin_norm >= cmd_min
        lin_acc = torch.clamp(1.0 - lin_error / cmd_lin_norm.clamp(min=cmd_min), min=0.0, max=1.0)
        lin_acc = torch.where(has_lin, lin_acc, torch.ones_like(lin_acc))

        # Angular velocity accuracy
        cmd_ang_abs = cmd_ang.abs()
        ang_error = (actual_ang - cmd_ang).abs()
        has_ang = cmd_ang_abs >= cmd_min
        ang_acc = torch.clamp(1.0 - ang_error / cmd_ang_abs.clamp(min=cmd_min), min=0.0, max=1.0)
        ang_acc = torch.where(has_ang, ang_acc, torch.ones_like(ang_acc))

        # Weighted combination: only count dimensions that have a non-trivial command
        lin_w = has_lin.float()
        ang_w = has_ang.float()
        total_w = (lin_w + ang_w).clamp(min=1.0)
        combined = (lin_w * lin_acc + ang_w * ang_acc) / total_w

        # Only accumulate for envs with at least one active command dimension
        active = has_lin | has_ang
        self._env_accuracy_sum += combined * active.float()
        self._env_accuracy_count += active.long()

        # Zero-speed accuracy: for standing envs (cmd=0), accuracy is based on
        # how still the robot is. Perfectly still = 1.0.
        is_zero_cmd = ~active  # envs with no active command dimension
        if is_zero_cmd.any():
            vel_lin = torch.norm(actual_lin, dim=1)
            vel_ang = actual_ang.abs()
            vel_total = torch.max(vel_lin, vel_ang)
            zero_thr = self.cfg.zero_speed_accuracy_threshold
            zero_acc = torch.clamp(1.0 - vel_total / zero_thr, min=0.0, max=1.0)
            self._env_accuracy_sum += zero_acc * is_zero_cmd.float()
            self._env_accuracy_count += is_zero_cmd.long()

    def get_episode_accuracy(self, env_ids):
        """Get average relative accuracy for completed episodes, then reset accumulators."""
        if isinstance(env_ids, torch.Tensor):
            eids = env_ids
        else:
            eids = torch.tensor(env_ids, device=self.device, dtype=torch.long)

        count = self._env_accuracy_count[eids].clamp(min=1).float()
        accuracy = self._env_accuracy_sum[eids] / count
        # Reset accumulators for these envs
        self._env_accuracy_sum[eids] = 0.0
        self._env_accuracy_count[eids] = 0
        return accuracy

    def update_bin_performance(self, env_ids, accuracy):
        """EMA update of bin performance using per-env relative accuracy."""
        alpha = self.cfg.ema_alpha
        if isinstance(env_ids, torch.Tensor):
            eids = env_ids
        else:
            eids = torch.tensor(env_ids, device=self.device, dtype=torch.long)

        # Exclude standing/rotating envs from bin EMA:
        # their pre-determined commands shouldn't bias adaptive sampling weights
        normal_mask = ~(self.is_standing_env[eids] | self.is_rotating_env[eids] | self.is_linear_env[eids])
        if normal_mask.sum() == 0:
            return
        eids = eids[normal_mask]
        accuracy = accuracy[normal_mask]

        vb = self._env_vx_bin[eids]
        wb = self._env_wz_bin[eids]
        n_wz = len(self.cfg.wz_bins)
        flat_bin = vb * n_wz + wb

        for b in flat_bin.unique():
            mask = flat_bin == b
            vi = b.item() // n_wz
            wi = b.item() % n_wz
            mean_acc = accuracy[mask].mean()
            self._bin_perf[vi, wi] = (1.0 - alpha) * self._bin_perf[vi, wi] + alpha * mean_acc
            self._bin_update_count[vi, wi] += mask.sum()

    def expand_active_bins(self, n_add: int = 2):
        """Expand the number of active bins by n_add (staged curriculum).

        Bins should be ordered center-outward in the config so that
        activating more bins = expanding to higher speeds.
        """
        n_vx = self._vx_edges.shape[0]
        n_wz = self._wz_edges.shape[0]
        if self._active_n_vx >= n_vx and self._active_n_wz >= n_wz:
            return  # all bins already active
        old_vx = self._active_n_vx
        old_wz = self._active_n_wz
        self._active_n_vx = min(self._active_n_vx + n_add, n_vx)
        self._active_n_wz = min(self._active_n_wz + n_add, n_wz)
        self._update_active_mask()
        if self._active_n_vx > old_vx or self._active_n_wz > old_wz:
            print(
                f"[AdaptiveSampling] Expanded active bins: "
                f"vx {old_vx}->{self._active_n_vx}/{n_vx}, "
                f"wz {old_wz}->{self._active_n_wz}/{n_wz}",
                flush=True,
            )
        # Update ranges for logging
        active_vx = self._vx_edges[:self._active_n_vx]
        active_wz = self._wz_edges[:self._active_n_wz]
        self.cfg.ranges.lin_vel_x = (active_vx.min().item(), active_vx.max().item())
        self.cfg.ranges.ang_vel_z = (active_wz.min().item(), active_wz.max().item())

    def expand_outermost_bins(self, expand_rate: float = 0.2):
        """Expand the outermost bins toward their limits.

        Outermost bins:
          - vx backward: bin 0 (lo expands toward limit_ranges.lin_vel_x[0])
          - vx forward:  bin -1 (hi expands toward limit_ranges.lin_vel_x[1])
          - wz negative: bin 0 (lo expands toward limit_ranges.ang_vel_z[0])
          - wz positive: bin -1 (hi expands toward limit_ranges.ang_vel_z[1])
        """
        lr = self.cfg.limit_ranges

        # Expand vx backward bin[0].lo
        old_lo = self._vx_edges[0, 0].item()
        target_lo = lr.lin_vel_x[0]
        self._vx_edges[0, 0] = old_lo + expand_rate * (target_lo - old_lo)

        # Expand vx forward bin[-1].hi
        old_hi = self._vx_edges[-1, 1].item()
        target_hi = lr.lin_vel_x[1]
        self._vx_edges[-1, 1] = old_hi + expand_rate * (target_hi - old_hi)

        # Expand wz negative bin[0].lo
        old_lo = self._wz_edges[0, 0].item()
        target_lo = lr.ang_vel_z[0]
        self._wz_edges[0, 0] = old_lo + expand_rate * (target_lo - old_lo)

        # Expand wz positive bin[-1].hi
        old_hi = self._wz_edges[-1, 1].item()
        target_hi = lr.ang_vel_z[1]
        self._wz_edges[-1, 1] = old_hi + expand_rate * (target_hi - old_hi)

        # Sync cfg.ranges for compatibility with base class and logging
        self.cfg.ranges.lin_vel_x = (self._vx_edges[0, 0].item(), self._vx_edges[-1, 1].item())
        self.cfg.ranges.ang_vel_z = (self._wz_edges[0, 0].item(), self._wz_edges[-1, 1].item())

    def log_sampling_stats(self):
        """Print current bin performance and sampling probabilities."""
        n_vx = len(self.cfg.vx_bins)
        n_wz = len(self.cfg.wz_bins)
        probs = self._compute_sampling_probs().view(n_vx, n_wz)

        r = self.cfg.ranges
        lines = [
            f"\n[AdaptiveSampling] "
            f"vx=({r.lin_vel_x[0]:.2f}..{r.lin_vel_x[1]:.2f}) "
            f"wz=({r.ang_vel_z[0]:.2f}..{r.ang_vel_z[1]:.2f}) "
            f"vx_bins={n_vx}  wz_bins={n_wz}"
        ]

        # Header: wz bin ranges
        wz_hdr = [f"wz[{self._wz_edges[j,0]:.2f},{self._wz_edges[j,1]:.2f}]" for j in range(n_wz)]
        lines.append("  " + " " * 22 + "  ".join(f"{h:>22s}" for h in wz_hdr))

        # Bin performance
        lines.append("  Bin Performance:")
        for i in range(n_vx):
            label = f"vx[{self._vx_edges[i,0]:+.2f},{self._vx_edges[i,1]:+.2f}]"
            vals = "  ".join(
                f"{self._bin_perf[i, j]:.3f}(n={self._bin_update_count[i, j].item():>4d})"
                for j in range(n_wz)
            )
            lines.append(f"  {label:>22s}  {vals}")

        # Sampling probabilities
        lines.append("  Sampling Probabilities:")
        for i in range(n_vx):
            label = f"vx[{self._vx_edges[i,0]:+.2f},{self._vx_edges[i,1]:+.2f}]"
            vals = "  ".join(f"{probs[i, j]:>22.4f}" for j in range(n_wz))
            lines.append(f"  {label:>22s}  {vals}")

        print("\n".join(lines), flush=True)


# NOTE: same __post_init__ pattern needed (see UniformLevelVelocityCommandCfg above)
_pwvc_orig_post_init = PerformanceWeightedVelocityCommandCfg.__post_init__
def _pwvc_post_init(self):
    _pwvc_orig_post_init(self)
    self.class_type = PerformanceWeightedVelocityCommand
PerformanceWeightedVelocityCommandCfg.__post_init__ = _pwvc_post_init


# ============================================================================
# Discrete Velocity Command (V18 — Exact Discrete Levels)
#
# Instead of sampling continuous velocities from ranges, picks from an
# explicit set of discrete levels. Motivation:
#   1. Real joystick deployment uses discrete speed steps
#   2. Each discrete level gets concentrated training (like multi-task RL)
#   3. No interpolation exploit: policy must learn each level specifically
#   4. Training distribution matches deployment distribution exactly
# ============================================================================


@configclass
class DiscreteVelocityCommandCfg(UniformVelocityCommandCfg):
    """Cfg for discrete velocity command with explicit level sets."""
    rel_rotating_envs: float = 0.0
    """Fraction of envs that are pure-rotation (vx=0, wz from nonzero wz_levels)."""

    vx_levels: list[float] = MISSING
    """Discrete lin_vel_x levels (include 0 for completeness; standing handled separately)."""

    wz_levels: list[float] = MISSING
    """Discrete ang_vel_z levels (include 0 for straight walking)."""

    vy_levels: list[float] | None = None
    """Discrete lin_vel_y levels. If None, vy=0 always."""


class DiscreteVelocityCommand(UniformVelocityCommand):
    """Velocity command that samples from discrete level sets instead of continuous ranges.

    Each resample picks exact values from the configured level lists.
    Standing envs get (0,0,0). Rotating envs get (0,0,wz!=0).
    Normal envs get (vx!=0, vy, wz_any).
    """

    cfg: DiscreteVelocityCommandCfg

    def __init__(self, cfg: DiscreteVelocityCommandCfg, env):
        super().__init__(cfg, env)
        self.is_rotating_env = torch.zeros(self.num_envs, dtype=torch.bool, device=self.device)

        # Pre-compute level tensors
        self._vx_all = torch.tensor(cfg.vx_levels, device=self.device, dtype=torch.float32)
        self._wz_all = torch.tensor(cfg.wz_levels, device=self.device, dtype=torch.float32)
        self._vx_nonzero = self._vx_all[self._vx_all.abs() > 1e-6]
        self._wz_nonzero = self._wz_all[self._wz_all.abs() > 1e-6]

        if cfg.vy_levels is not None:
            self._vy_all = torch.tensor(cfg.vy_levels, device=self.device, dtype=torch.float32)
        else:
            self._vy_all = torch.zeros(1, device=self.device)

    def _resample_command(self, env_ids: Sequence[int]):
        b = len(env_ids)
        if b == 0:
            return

        r = torch.rand(b, device=self.device)

        # --- Determine env types ---
        standing_mask = r < self.cfg.rel_standing_envs
        rotating_mask = (~standing_mask) & (
            r < self.cfg.rel_standing_envs + self.cfg.rel_rotating_envs
        )
        normal_mask = ~(standing_mask | rotating_mask)

        self.is_standing_env[env_ids] = standing_mask
        self.is_rotating_env[env_ids] = rotating_mask

        # --- Sample vx: nonzero for normal envs, 0 for standing/rotating ---
        vx = torch.zeros(b, device=self.device)
        n_normal = normal_mask.sum().item()
        if n_normal > 0:
            idx = torch.randint(0, len(self._vx_nonzero), (n_normal,), device=self.device)
            vx[normal_mask] = self._vx_nonzero[idx]

        # --- Sample vy ---
        vy_idx = torch.randint(0, len(self._vy_all), (b,), device=self.device)
        vy = self._vy_all[vy_idx]
        vy[standing_mask] = 0.0

        # --- Sample wz ---
        wz = torch.zeros(b, device=self.device)
        # Normal envs: any wz level (including 0 for straight walking)
        if n_normal > 0:
            idx = torch.randint(0, len(self._wz_all), (n_normal,), device=self.device)
            wz[normal_mask] = self._wz_all[idx]
        # Rotating envs: nonzero wz only
        n_rot = rotating_mask.sum().item()
        if n_rot > 0:
            idx = torch.randint(0, len(self._wz_nonzero), (n_rot,), device=self.device)
            wz[rotating_mask] = self._wz_nonzero[idx]

        self.vel_command_b[env_ids, 0] = vx
        self.vel_command_b[env_ids, 1] = vy
        self.vel_command_b[env_ids, 2] = wz

    def _update_command(self):
        """Enforce standing (all zero) and rotating (lin_vel zero) every step."""
        standing_ids = self.is_standing_env.nonzero(as_tuple=False).flatten()
        self.vel_command_b[standing_ids, :] = 0.0
        rotating_ids = self.is_rotating_env.nonzero(as_tuple=False).flatten()
        self.vel_command_b[rotating_ids, :2] = 0.0


# Patch the cfg to use our custom command class
_dvc_orig_post_init = DiscreteVelocityCommandCfg.__post_init__
def _dvc_post_init(self):
    _dvc_orig_post_init(self)
    self.class_type = DiscreteVelocityCommand
DiscreteVelocityCommandCfg.__post_init__ = _dvc_post_init


# ======================================================================
# Marginal Velocity Command (V19 — Axis-Independent Sampling)
#
# Key differences from PerformanceWeightedVelocityCommand (V2):
#   1. AXIS-INDEPENDENT sampling: vx, vy, wz sampled independently
#   2. AXIS-SPECIFIC accuracy: vx_acc, vy_acc, wz_acc tracked separately
#      (no combined accuracy that dilutes dead-zone signals)
#   3. PER-DIRECTION curriculum: vx_pos, vx_neg, vy, wz expand independently
#   4. vy included in adaptive framework (was uniform before)
#   5. Expansion gate uses mean(perf) not min(perf)
#   6. Discrete bins with 0.1 granularity auto-filled on expansion
# ======================================================================


@configclass
class MarginalVelocityCommandCfg(UniformVelocityCommandCfg):
    """Cfg for marginal velocity command with axis-independent sampling."""
    rel_rotating_envs: float = 0.0
    rel_linear_envs: float = 0.0

    # Per-direction bin definitions.
    # Each bin is (lo, hi). Discrete: lo==hi -> exact value.
    # Ordered by ascending magnitude for curriculum expansion.
    vx_pos_bins: list[Any] = field(default_factory=lambda: [
        (0.1, 0.1), (0.2, 0.2), (0.3, 0.3),
    ])
    vx_neg_bins: list[Any] = field(default_factory=lambda: [
        (-0.1, -0.1), (-0.2, -0.2), (-0.3, -0.3),
    ])
    # vy bins: ordered with zero first, then pairs by magnitude.
    vy_bins: list[Any] = field(default_factory=lambda: [
        (0.0, 0.0),
        (0.1, 0.1), (-0.1, -0.1),
        (0.2, 0.2), (-0.2, -0.2),
        (0.3, 0.3), (-0.3, -0.3),
    ])
    # wz bins: ordered as pairs by magnitude (no zero -- handled by standing).
    wz_bins: list[Any] = field(default_factory=lambda: [
        (0.1, 0.1), (-0.1, -0.1),
        (0.2, 0.2), (-0.2, -0.2),
        (0.3, 0.3), (-0.3, -0.3),
    ])

    # Initial active bin counts for staged curriculum (None = all active)
    num_active_vx_pos: int | None = None
    num_active_vx_neg: int | None = None
    num_active_vy: int | None = None
    num_active_wz: int | None = None

    # Adaptive sampling parameters
    ema_alpha: float = 0.1
    temperature: float = 3.0
    min_sampling_prob: float = 0.02
    accuracy_cmd_min: float = 0.05
    """Minimum command magnitude for accuracy computation."""
    zero_speed_accuracy_threshold: float = 0.10
    """Velocity threshold for zero-speed accuracy."""


class MarginalVelocityCommand(UniformVelocityCommand):
    """Velocity command with axis-independent marginal sampling.

    Each axis (vx, vy, wz) is sampled independently using its own
    performance-weighted distribution. Accuracy is tracked per-axis
    (not combined), so dead-zone signals are not diluted.
    """

    cfg: MarginalVelocityCommandCfg

    def __init__(self, cfg: MarginalVelocityCommandCfg, env):
        super().__init__(cfg, env)
        self.is_rotating_env = torch.zeros(self.num_envs, dtype=torch.bool, device=self.device)
        self.is_linear_env = torch.zeros(self.num_envs, dtype=torch.bool, device=self.device)

        # --- Build internal edge tensors ---
        # vx: [zero] + neg_bins + pos_bins
        n_neg = len(cfg.vx_neg_bins)
        n_pos = len(cfg.vx_pos_bins)
        vx_all = [(0.0, 0.0)] + list(cfg.vx_neg_bins) + list(cfg.vx_pos_bins)
        self._vx_edges = torch.tensor(vx_all, device=self.device, dtype=torch.float32)
        self._vx_zero_idx = 0
        self._vx_neg_start = 1
        self._vx_neg_end = 1 + n_neg
        self._vx_pos_start = 1 + n_neg
        self._vx_pos_end = 1 + n_neg + n_pos

        # vy: as configured (zero first, then pairs)
        self._vy_edges = torch.tensor(cfg.vy_bins, device=self.device, dtype=torch.float32)
        self._vy_zero_idx = -1
        for i, (lo, hi) in enumerate(cfg.vy_bins):
            if abs(lo) < 1e-6 and abs(hi) < 1e-6:
                self._vy_zero_idx = i
                break

        # wz: [zero] + wz_bins
        wz_all = [(0.0, 0.0)] + list(cfg.wz_bins)
        self._wz_edges = torch.tensor(wz_all, device=self.device, dtype=torch.float32)
        self._wz_zero_idx = 0

        n_vx = len(vx_all)
        n_vy = len(cfg.vy_bins)
        n_wz = len(wz_all)

        # Per-axis performance EMA (init 0.5 = neutral)
        self._vx_perf = torch.full((n_vx,), 0.5, device=self.device)
        self._vy_perf = torch.full((n_vy,), 0.5, device=self.device)
        self._wz_perf = torch.full((n_wz,), 0.5, device=self.device)

        # Per-axis update counts
        self._vx_update_count = torch.zeros(n_vx, dtype=torch.long, device=self.device)
        self._vy_update_count = torch.zeros(n_vy, dtype=torch.long, device=self.device)
        self._wz_update_count = torch.zeros(n_wz, dtype=torch.long, device=self.device)

        # Per-env bin tracking
        self._env_vx_bin = torch.zeros(self.num_envs, dtype=torch.long, device=self.device)
        self._env_vy_bin = torch.zeros(self.num_envs, dtype=torch.long, device=self.device)
        self._env_wz_bin = torch.zeros(self.num_envs, dtype=torch.long, device=self.device)

        # Per-env per-axis accuracy accumulators
        self._env_vx_acc_sum = torch.zeros(self.num_envs, device=self.device)
        self._env_vy_acc_sum = torch.zeros(self.num_envs, device=self.device)
        self._env_wz_acc_sum = torch.zeros(self.num_envs, device=self.device)
        self._env_vx_acc_count = torch.zeros(self.num_envs, dtype=torch.long, device=self.device)
        self._env_vy_acc_count = torch.zeros(self.num_envs, dtype=torch.long, device=self.device)
        self._env_wz_acc_count = torch.zeros(self.num_envs, dtype=torch.long, device=self.device)

        # Active bin counts for staged curriculum
        self._active_n_vx_pos = n_pos if cfg.num_active_vx_pos is None else min(cfg.num_active_vx_pos, n_pos)
        self._active_n_vx_neg = n_neg if cfg.num_active_vx_neg is None else min(cfg.num_active_vx_neg, n_neg)
        self._active_n_vy = n_vy if cfg.num_active_vy is None else min(cfg.num_active_vy, n_vy)
        self._active_n_wz = len(cfg.wz_bins) if cfg.num_active_wz is None else min(cfg.num_active_wz, len(cfg.wz_bins))
        self._update_active_masks()

    def _update_active_masks(self):
        """Build per-axis active and sample masks."""
        n_vx = self._vx_edges.shape[0]
        n_vy = self._vy_edges.shape[0]
        n_wz = self._wz_edges.shape[0]

        # vx: zero always active; first N_neg of neg, first N_pos of pos
        self._vx_active = torch.zeros(n_vx, dtype=torch.bool, device=self.device)
        self._vx_active[self._vx_zero_idx] = True
        self._vx_active[self._vx_neg_start:self._vx_neg_start + self._active_n_vx_neg] = True
        self._vx_active[self._vx_pos_start:self._vx_pos_start + self._active_n_vx_pos] = True
        # Sample mask: active minus zero (standing/rotating handle zero)
        self._vx_sample_mask = self._vx_active.clone()
        self._vx_sample_mask[self._vx_zero_idx] = False

        # vy: first N_vy bins are active. vy=0 IS in the adaptive pool.
        self._vy_active = torch.zeros(n_vy, dtype=torch.bool, device=self.device)
        self._vy_active[:self._active_n_vy] = True
        self._vy_sample_mask = self._vy_active.clone()

        # wz: zero always active; first N_wz of wz_bins
        self._wz_active = torch.zeros(n_wz, dtype=torch.bool, device=self.device)
        self._wz_active[self._wz_zero_idx] = True
        self._wz_active[1:1 + self._active_n_wz] = True
        # Sample mask: active minus zero
        self._wz_sample_mask = self._wz_active.clone()
        self._wz_sample_mask[self._wz_zero_idx] = False

    def _compute_axis_probs(self, perf, sample_mask):
        """Compute sampling probs for one axis: worse -> higher prob."""
        difficulty = 1.0 - perf
        logits = difficulty * self.cfg.temperature
        logits[~sample_mask] = float('-inf')
        probs = torch.softmax(logits, dim=0)
        n_active = (probs > 0).sum().item()
        if n_active > 0:
            floor = min(self.cfg.min_sampling_prob, 0.5 / n_active)
            probs = torch.clamp(probs, min=floor)
            probs[~sample_mask] = 0.0
            probs = probs / probs.sum()
        return probs

    def _resample_command(self, env_ids: Sequence[int]):
        if isinstance(env_ids, torch.Tensor):
            env_ids_t = env_ids
            n = env_ids.shape[0]
        else:
            n = len(env_ids)
            env_ids_t = torch.tensor(env_ids, device=self.device, dtype=torch.long)
        if n == 0:
            return

        # --- Independent axis sampling ---
        vx_probs = self._compute_axis_probs(self._vx_perf, self._vx_sample_mask)
        vy_probs = self._compute_axis_probs(self._vy_perf, self._vy_sample_mask)
        wz_probs = self._compute_axis_probs(self._wz_perf, self._wz_sample_mask)

        vx_bin = torch.multinomial(vx_probs, n, replacement=True)
        vy_bin = torch.multinomial(vy_probs, n, replacement=True)
        wz_bin = torch.multinomial(wz_probs, n, replacement=True)

        self._env_vx_bin[env_ids_t] = vx_bin
        self._env_vy_bin[env_ids_t] = vy_bin
        self._env_wz_bin[env_ids_t] = wz_bin

        # Sample values within bins
        vx_lo = self._vx_edges[vx_bin, 0]
        vx_hi = self._vx_edges[vx_bin, 1]
        vx = vx_lo + torch.rand(n, device=self.device) * (vx_hi - vx_lo)

        vy_lo = self._vy_edges[vy_bin, 0]
        vy_hi = self._vy_edges[vy_bin, 1]
        vy = vy_lo + torch.rand(n, device=self.device) * (vy_hi - vy_lo)

        wz_lo = self._wz_edges[wz_bin, 0]
        wz_hi = self._wz_edges[wz_bin, 1]
        wz = wz_lo + torch.rand(n, device=self.device) * (wz_hi - wz_lo)

        self.vel_command_b[env_ids_t, 0] = vx
        self.vel_command_b[env_ids_t, 1] = vy
        self.vel_command_b[env_ids_t, 2] = wz

        # --- Env type assignment ---
        self.is_standing_env[env_ids_t] = torch.rand(n, device=self.device) <= self.cfg.rel_standing_envs
        self.is_rotating_env[env_ids_t] = torch.rand(n, device=self.device) <= self.cfg.rel_rotating_envs
        self.is_linear_env[env_ids_t] = torch.rand(n, device=self.device) <= self.cfg.rel_linear_envs

        # Route forced-zero axes to zero bins
        standing_local = self.is_standing_env[env_ids_t]
        rotating_local = self.is_rotating_env[env_ids_t]
        linear_local = self.is_linear_env[env_ids_t]

        # Standing & Rotating: vx->zero, vy->zero
        force_zero_lin = standing_local | rotating_local
        self._env_vx_bin[env_ids_t[force_zero_lin]] = self._vx_zero_idx
        if self._vy_zero_idx >= 0:
            self._env_vy_bin[env_ids_t[force_zero_lin]] = self._vy_zero_idx

        # Standing & Linear: wz->zero
        force_zero_wz = standing_local | linear_local
        self._env_wz_bin[env_ids_t[force_zero_wz]] = self._wz_zero_idx

        if self.cfg.heading_command:
            self.heading_target[env_ids_t] = torch.empty(n, device=self.device).uniform_(*self.cfg.ranges.heading)
            self.is_heading_env[env_ids_t] = torch.rand(n, device=self.device) <= self.cfg.rel_heading_envs

    def _update_command(self):
        super()._update_command()  # zeros standing envs, computes heading
        # Enforce pure rotation for rotating envs
        rotating_ids = self.is_rotating_env.nonzero(as_tuple=False).flatten()
        self.vel_command_b[rotating_ids, :2] = 0.0
        # Enforce pure linear for linear envs
        linear_ids = self.is_linear_env.nonzero(as_tuple=False).flatten()
        self.vel_command_b[linear_ids, 2] = 0.0

        # --- Per-axis accuracy accumulation ---
        cmd_vx = self.vel_command_b[:, 0]
        cmd_vy = self.vel_command_b[:, 1]
        cmd_wz = self.vel_command_b[:, 2]
        actual_vx = self.robot.data.root_lin_vel_b[:, 0]
        actual_vy = self.robot.data.root_lin_vel_b[:, 1]
        actual_wz = self.robot.data.root_ang_vel_b[:, 2]

        cmd_min = self.cfg.accuracy_cmd_min
        zero_thr = self.cfg.zero_speed_accuracy_threshold

        # vx accuracy
        cmd_vx_abs = cmd_vx.abs()
        has_vx = cmd_vx_abs >= cmd_min
        vx_acc = torch.where(
            has_vx,
            torch.clamp(1.0 - (actual_vx - cmd_vx).abs() / cmd_vx_abs.clamp(min=cmd_min), min=0.0, max=1.0),
            torch.clamp(1.0 - actual_vx.abs() / zero_thr, min=0.0, max=1.0),
        )
        self._env_vx_acc_sum += vx_acc
        self._env_vx_acc_count += 1

        # vy accuracy
        cmd_vy_abs = cmd_vy.abs()
        has_vy = cmd_vy_abs >= cmd_min
        vy_acc = torch.where(
            has_vy,
            torch.clamp(1.0 - (actual_vy - cmd_vy).abs() / cmd_vy_abs.clamp(min=cmd_min), min=0.0, max=1.0),
            torch.clamp(1.0 - actual_vy.abs() / zero_thr, min=0.0, max=1.0),
        )
        self._env_vy_acc_sum += vy_acc
        self._env_vy_acc_count += 1

        # wz accuracy
        cmd_wz_abs = cmd_wz.abs()
        has_wz = cmd_wz_abs >= cmd_min
        wz_acc = torch.where(
            has_wz,
            torch.clamp(1.0 - (actual_wz - cmd_wz).abs() / cmd_wz_abs.clamp(min=cmd_min), min=0.0, max=1.0),
            torch.clamp(1.0 - actual_wz.abs() / zero_thr, min=0.0, max=1.0),
        )
        self._env_wz_acc_sum += wz_acc
        self._env_wz_acc_count += 1

    def get_episode_accuracy(self, env_ids):
        """Get per-axis average accuracy for completed episodes, then reset."""
        if isinstance(env_ids, torch.Tensor):
            eids = env_ids
        else:
            eids = torch.tensor(env_ids, device=self.device, dtype=torch.long)

        vx_count = self._env_vx_acc_count[eids].clamp(min=1).float()
        vy_count = self._env_vy_acc_count[eids].clamp(min=1).float()
        wz_count = self._env_wz_acc_count[eids].clamp(min=1).float()

        vx_acc = self._env_vx_acc_sum[eids] / vx_count
        vy_acc = self._env_vy_acc_sum[eids] / vy_count
        wz_acc = self._env_wz_acc_sum[eids] / wz_count

        # Reset accumulators
        self._env_vx_acc_sum[eids] = 0.0
        self._env_vy_acc_sum[eids] = 0.0
        self._env_wz_acc_sum[eids] = 0.0
        self._env_vx_acc_count[eids] = 0
        self._env_vy_acc_count[eids] = 0
        self._env_wz_acc_count[eids] = 0

        return vx_acc, vy_acc, wz_acc

    def update_bin_performance(self, env_ids, vx_acc, vy_acc, wz_acc):
        """Per-axis EMA update with correct exclusions."""
        alpha = self.cfg.ema_alpha
        if isinstance(env_ids, torch.Tensor):
            eids = env_ids
        else:
            eids = torch.tensor(env_ids, device=self.device, dtype=torch.long)

        standing = self.is_standing_env[eids]
        rotating = self.is_rotating_env[eids]
        linear = self.is_linear_env[eids]

        # vx perf: exclude standing & rotating (forced vx=0)
        vx_mask = ~(standing | rotating)
        if vx_mask.sum() > 0:
            vx_eids = eids[vx_mask]
            vx_a = vx_acc[vx_mask]
            vx_bins = self._env_vx_bin[vx_eids]
            for b in vx_bins.unique():
                m = vx_bins == b
                self._vx_perf[b] = (1.0 - alpha) * self._vx_perf[b] + alpha * vx_a[m].mean()
                self._vx_update_count[b] += m.sum()

        # vy perf: exclude standing & rotating (forced vy=0)
        vy_mask = ~(standing | rotating)
        if vy_mask.sum() > 0:
            vy_eids = eids[vy_mask]
            vy_a = vy_acc[vy_mask]
            vy_bins = self._env_vy_bin[vy_eids]
            for b in vy_bins.unique():
                m = vy_bins == b
                self._vy_perf[b] = (1.0 - alpha) * self._vy_perf[b] + alpha * vy_a[m].mean()
                self._vy_update_count[b] += m.sum()

        # wz perf: exclude standing & linear (forced wz=0)
        wz_mask = ~(standing | linear)
        if wz_mask.sum() > 0:
            wz_eids = eids[wz_mask]
            wz_a = wz_acc[wz_mask]
            wz_bins = self._env_wz_bin[wz_eids]
            for b in wz_bins.unique():
                m = wz_bins == b
                self._wz_perf[b] = (1.0 - alpha) * self._wz_perf[b] + alpha * wz_a[m].mean()
                self._wz_update_count[b] += m.sum()

    def expand_direction(self, direction: str, n_add: int = 1):
        """Expand active bins for one direction."""
        n_neg_total = self._vx_neg_end - self._vx_neg_start
        n_pos_total = self._vx_pos_end - self._vx_pos_start
        n_vy_total = self._vy_edges.shape[0]
        n_wz_total = len(self.cfg.wz_bins)

        old = None
        if direction == 'vx_pos':
            old = self._active_n_vx_pos
            self._active_n_vx_pos = min(self._active_n_vx_pos + n_add, n_pos_total)
            new = self._active_n_vx_pos
        elif direction == 'vx_neg':
            old = self._active_n_vx_neg
            self._active_n_vx_neg = min(self._active_n_vx_neg + n_add, n_neg_total)
            new = self._active_n_vx_neg
        elif direction == 'vy':
            old = self._active_n_vy
            self._active_n_vy = min(self._active_n_vy + n_add, n_vy_total)
            new = self._active_n_vy
        elif direction == 'wz':
            old = self._active_n_wz
            self._active_n_wz = min(self._active_n_wz + n_add, n_wz_total)
            new = self._active_n_wz
        else:
            return

        if new > old:
            self._update_active_masks()
            # Show new bin edges
            if direction == 'vx_pos':
                edges = self._vx_edges[self._vx_pos_start:self._vx_pos_start + self._active_n_vx_pos]
            elif direction == 'vx_neg':
                edges = self._vx_edges[self._vx_neg_start:self._vx_neg_start + self._active_n_vx_neg]
            elif direction == 'vy':
                edges = self._vy_edges[:self._active_n_vy]
            else:
                edges = self._wz_edges[1:1 + self._active_n_wz]
            vals = [f"{e[0].item():+.1f}" for e in edges]
            print(
                f"[MarginalSampling] Expanded {direction}: {old}->{new} bins, "
                f"values: [{', '.join(vals)}]",
                flush=True,
            )

    def get_active_indices(self, direction: str):
        """Return indices of active non-zero bins for a direction."""
        if direction == 'vx_pos':
            return list(range(self._vx_pos_start, self._vx_pos_start + self._active_n_vx_pos))
        elif direction == 'vx_neg':
            return list(range(self._vx_neg_start, self._vx_neg_start + self._active_n_vx_neg))
        elif direction == 'vy':
            return list(range(self._active_n_vy))
        elif direction == 'wz':
            return list(range(1, 1 + self._active_n_wz))
        return []

    def log_sampling_stats(self):
        """Print compact per-axis marginal distributions."""
        vx_probs = self._compute_axis_probs(self._vx_perf, self._vx_sample_mask)
        vy_probs = self._compute_axis_probs(self._vy_perf, self._vy_sample_mask)
        wz_probs = self._compute_axis_probs(self._wz_perf, self._wz_sample_mask)

        def _fmt_axis(name, edges, perf, probs, update_count, active_mask, sample_mask):
            n = edges.shape[0]
            n_active = active_mask.sum().item()
            n_sample = sample_mask.sum().item()
            lines = [f"\n[Marginal] {name} ({n_sample} sampling / {n_active} active / {n} total):"]
            for i in range(n):
                if not active_mask[i]:
                    continue
                val = edges[i, 0].item()
                p = perf[i].item()
                pr = probs[i].item()
                cnt = update_count[i].item()
                marker = " *" if sample_mask[i] and pr > 0 else "  "
                lines.append(
                    f"  {val:+6.2f}  perf={p:.3f}  prob={pr*100:5.1f}%  n={cnt:>6d}{marker}"
                )
            return "\n".join(lines)

        parts = [
            _fmt_axis("vx", self._vx_edges, self._vx_perf, vx_probs,
                       self._vx_update_count, self._vx_active, self._vx_sample_mask),
            _fmt_axis("vy", self._vy_edges, self._vy_perf, vy_probs,
                       self._vy_update_count, self._vy_active, self._vy_sample_mask),
            _fmt_axis("wz", self._wz_edges, self._wz_perf, wz_probs,
                       self._wz_update_count, self._wz_active, self._wz_sample_mask),
        ]
        print("".join(parts), flush=True)


# Patch the cfg to use our custom command class
_mvc_orig_post_init = MarginalVelocityCommandCfg.__post_init__
def _mvc_post_init(self):
    _mvc_orig_post_init(self)
    self.class_type = MarginalVelocityCommand
MarginalVelocityCommandCfg.__post_init__ = _mvc_post_init
